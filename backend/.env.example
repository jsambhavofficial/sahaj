ENVIRONMENT=development
# Supabase Postgres connection string (use the direct/session string for migrations)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
JWT_SECRET=change-me
# Bhashini portal: My Profile -> User ID, "Udyat key" (API key) and Inference key
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
AWS_REGION=ap-south-1
# AWS credentials for Bedrock: set in your shell or .env, never commit
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Demo clock (YYYY-MM-DD). Leave empty to use the real date.
DEMO_TODAY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public URL of this service (no trailing slash needed; it is stripped)
PUBLIC_BASE_URL=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=
# stub | real provider names; stubs need no accounts
STT_PROVIDER=stub
TTS_PROVIDER=stub
LLM_PROVIDER=stub
TELEPHONY_PROVIDER=stub
PUSH_PROVIDER=stub
STORAGE_PROVIDER=stub
