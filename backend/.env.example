ENVIRONMENT=development
# Supabase Postgres connection string (use the direct/session string for migrations)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
JWT_SECRET=change-me
# Bhashini portal: My Profile -> User ID, "Udyat key" (API key) and Inference key
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
# Sarvam AI (dashboard.sarvam.ai): set STT_PROVIDER / TTS_PROVIDER to sarvam to use it
SARVAM_API_KEY=
# Groq (console.groq.com, key starts gsk_): set LLM_PROVIDER=groq to use it
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Google Gemini (aistudio.google.com/apikey): set LLM_PROVIDER=gemini to use it
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
AWS_REGION=ap-south-1
# AWS credentials for Bedrock: set in your shell or .env, never commit
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Demo clock (YYYY-MM-DD). Leave empty to use the real date.
DEMO_TODAY=
# Websites allowed to call the API from a browser. Add the deployed web portal's address here
# (a CORS error in the browser console usually means its address is missing).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006
# Optional: a pattern for addresses that change, e.g. Vercel previews or a LAN address
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.vercel\.app
# Public URL of this service (no trailing slash needed; it is stripped)
PUBLIC_BASE_URL=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=
# stub | real provider names; stubs need no accounts
STT_PROVIDER=stub
TTS_PROVIDER=stub
LLM_PROVIDER=stub
TELEPHONY_PROVIDER=stub
PUSH_PROVIDER=stub
STORAGE_PROVIDER=stub
# Connections per API process. The Supabase session pooler allows 15 in total across every running copy of the API.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# Voice agent voice: male | female (scripted lines are written in male Hindi grammar; for a female voice edit app/modules/voice/prompts)
# VOICE_AGENT_GENDER=male

# Firebase Cloud Messaging (FCM HTTP v1)
# Set PUSH_PROVIDER=fcm to enable production FCM delivery
# Pass either absolute/relative path to your service account JSON file, or raw JSON string:
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=
