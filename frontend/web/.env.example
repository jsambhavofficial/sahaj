# Samarth AI Frontend Environment Configuration

# Set to "mock" for isolated deterministic frontend testing/development
# Set to "live" to connect to the FastAPI backend
NEXT_PUBLIC_DATA_SOURCE=live

# FastAPI Backend Base URL (used when NEXT_PUBLIC_DATA_SOURCE=live)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Day the reports page opens on (the demo cohort ends on 2026-10-11). Leave empty for today.
NEXT_PUBLIC_DEMO_DATE=2026-10-11

# Firebase Cloud Messaging Web Push Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sahaj-3eb4d
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BBbklLj3udakJ4uQ4JKf6DtUrnqvWuPstwLXcJm0D1UK05sdL71Pvd_TWFTmDpREzTbb006J87bjVH3GmmL4GdM

# The web portal is for organization managers; add roles here only for testing other portals (e.g. the senior/caretaker notification pages).
# NEXT_PUBLIC_WEB_ROLES=ops,admin,city_manager,organization_admin,senior,coordinator,caretaker

# Firebase web app settings (Firebase console -> Project settings -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
