# Copy to .env and restart `npx expo start` (then fully reload the app).
# Where the app finds the backend. The path must end in /api/v1.
#
#   Android emulator -> the host machine is 10.0.2.2
#   iOS simulator    -> http://localhost:8000/api/v1
#   Physical phone   -> your computer's LAN address, e.g. http://192.168.1.20:8000/api/v1
#                       (phone and computer on the same Wi-Fi; start the backend with --host 0.0.0.0)
#   Deployed backend -> https://<your-service>.onrender.com/api/v1
#
# NOTE: if a request fails, the app silently shows built-in sample data instead
# (look for "Using contract fallback" in the Metro log).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Calls ring real phones and are recorded. Leave this off unless the backend has real telephony
# switched on (TELEPHONY_PROVIDER=exotel); otherwise the call screen only simulates a call.
EXPO_PUBLIC_ENABLE_REAL_CALLS=false
