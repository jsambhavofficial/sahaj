{
  "expo": {
    "name": "SAHAJ",
    "slug": "sahaj",
    "scheme": "sahaj",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4FBF7"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-secure-store"
    ]
  }
}
