{
  "expo": {
    "name": "SAHAJ",
    "slug": "sahaj",
    "scheme": "sahaj",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahaj.samarth"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4FBF7"
      },
      "package": "com.sahaj.samarth",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-notifications",
        {
          "defaultChannel": "sahaj_care_channel"
        }
      ]
    ]
  }
}
